      <aliases enabled='yes' />
      <column caption='Ad Spend' datatype='real' name='[AdSpend]' role='measure' type='quantitative' />
      <column caption='Advertising Platform' datatype='string' name='[AdvertisingPlatform]' role='dimension' type='nominal' />
      <column caption='Advertising Tool' datatype='string' name='[AdvertisingTool]' role='dimension' type='nominal' />
      <column caption='Conversion Rate - Calculated' datatype='real' name='[Calculation_0517915993440257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([ConversionRate])' />
      </column>
      <column caption='Income Bracket' datatype='string' name='[Calculation_0517916105269250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Income] &lt; 40000 THEN &quot;Under $40K&quot; ELSEIF [Income] &lt; 70000 THEN &quot;$40K–$70K&quot; ELSEIF [Income] &lt; 100000 THEN &quot;$70K–$100K&quot; ELSEIF [Income] &lt; 130000 THEN &quot;$100K–$130K&quot; ELSE &quot;$130K+&quot; END' />
      </column>
      <column caption='Age Bracket' datatype='string' name='[Calculation_0517916106960899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &quot;18–24&quot; ELSEIF [Age] &lt; 35 THEN &quot;25–34&quot; ELSEIF [Age] &lt; 45 THEN &quot;35–44&quot; ELSEIF [Age] &lt; 55 THEN &quot;45–54&quot; ELSEIF [Age] &lt; 65 THEN &quot;55–64&quot; ELSE &quot;65+&quot; END' />
      </column>
      <column caption='Ad Spend Rate' datatype='real' name='[Calculation_0517916118052868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AdSpend])/COUNT([CampaignChannel])' />
      </column>
      <column caption='Cost per Acquisition' datatype='real' name='[Calculation_0517917549735942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AdSpend]) / SUM([Conversion])' />
      </column>
      <column caption='Campaign Channel' datatype='string' name='[CampaignChannel]' role='dimension' type='nominal' />
      <column caption='Campaign Type' datatype='string' name='[CampaignType]' role='dimension' type='nominal' />
